generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum JobSourceType {
  MANUAL
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  USAJOBS
  REMOTIVE
  ADZUNA
  THEIRSTACK
  SERPAPI
  RSS
  COMPANY_CAREERS
}

enum PostingStatus {
  ACTIVE
  EXPIRED
  APPLIED
  REJECTED
  INTERVIEW
  OFFER
  ARCHIVED
}

enum ApplicationStatus {
  SAVED
  INTERESTED
  APPLIED
  RECRUITER_SCREEN
  HIRING_MANAGER_SCREEN
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  GHOSTED
  ARCHIVED
}

enum EventType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  EMAIL_SAVED
  RESUME_GENERATED
  COVER_LETTER_GENERATED
  INTERVIEW_ADDED
  FOLLOW_UP_SCHEDULED
  OUTCOME_RECORDED
  APPLICATION_RUN_EVENT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
  DRAFT
}

enum InterviewType {
  RECRUITER
  HIRING_MANAGER
  TECHNICAL
  PANEL
  FINAL
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentType {
  MASTER_RESUME
  TAILORED_RESUME
  COVER_LETTER
  EMAIL_DRAFT
  FOLLOW_UP_EMAIL
  INTERVIEW_PREP
  THANK_YOU_EMAIL
  OTHER
}

enum AIAnalysisType {
  RESUME_PARSE
  JOB_PARSE
  JOB_MATCH
  RESUME_TAILOR
  COVER_LETTER
  EMAIL_REPLY
  INTERVIEW_PREP
  INTERVIEW_FEEDBACK
}

enum ConsentStatus {
  NOT_APPLICABLE
  CONSENT_CONFIRMED
}

enum AutomationMode {
  PREPARE_ONLY
  FILL_AND_REVIEW
}

enum SensitiveAnswerPolicy {
  EXCLUDE
}

enum ApplicationRunState {
  DRAFT
  PREPARING
  READY
  FILLING
  REVIEW_REQUIRED
  READY_FOR_USER_SUBMISSION
  COMPLETED_BY_USER
  BLOCKED
  FAILED
  CANCELLED
}

enum ApplicationAnswerSourceType {
  PROFILE
  ANSWER_VAULT
  MASTER_RESUME
  TAILORED_RESUME
  APPLICATION_PLAN
  USER_PROVIDED
  GENERATED_WITH_EVIDENCE
  COVER_LETTER
}

enum ApplicationFormFieldType {
  TEXT
  EMAIL
  TEL
  URL
  TEXTAREA
  SELECT_ONE
  SELECT_MANY
  RADIO_GROUP
  CHECKBOX_BOOLEAN
  CHECKBOX_GROUP
  NUMBER
  DATE
  FILE_UPLOAD
  UNSUPPORTED
}

enum ApplicationQuestionClassification {
  CONTACT
  PROFESSIONAL_LINK
  EXPERIENCE
  EDUCATION
  SKILL
  CITIZENSHIP_IMMIGRATION
  WORK_AUTHORIZATION
  SPONSORSHIP
  AVAILABILITY
  RELOCATION
  COMPENSATION
  DEMOGRAPHIC
  DISABILITY
  VETERAN
  CRIMINAL_HISTORY
  LEGAL_ATTESTATION
  DOCUMENT
  UNKNOWN
}

enum ApplicationAnswerDisposition {
  PROPOSABLE
  MANUAL_ONLY
  EXCLUDED
  UNSUPPORTED
}

enum ApplicationAnswerDispositionReason {
  NO_ELIGIBLE_SOURCE
  INVALID_SOURCE_VALUE
  AMBIGUOUS_SOURCE
  UNCONFIRMED_APPLICANT_CONTACT
  POLICY_EXCLUDED
  LEGAL_ATTESTATION
  V1_MANUAL_POLICY
  UNSUPPORTED_CONTROL
  AMBIGUOUS_FIELD
  AMBIGUOUS_CHOICES
  MULTIPLE_FILE_UPLOAD
  NO_SELECTED_DOCUMENT
  UNKNOWN_QUESTION
}

enum ApplicationAnswerReviewHashVersion {
  LEGACY_SCALAR_SHA256
  CANONICAL_PROPOSAL_V1
}

enum ApplicationRunAnswerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationRunStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ApplicationExecutionScope {
  APPLICATION_READ
  APPLICATION_FILL
  APPLICATION_EVENT_WRITE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile                UserProfile?
  accounts               Account[]
  sessions               Session[]
  resumes                Resume[]
  resumeVersions         ResumeVersion[]
  jobSources             JobSource[]
  jobPostings            JobPosting[]
  applications           Application[]
  applicationEvents      ApplicationEvent[]
  contacts               Contact[]
  emailMessages          EmailMessage[]
  interviews             Interview[]
  generatedDocs          GeneratedDocument[]
  aiAnalyses             AIAnalysis[]
  tasks                  Task[]
  reminders              FollowUpReminder[]
  storedFiles            StoredFile[]
  gmailIntegration       GmailIntegration?
  auditLogs              AuditLog[]
  browserCaptureTokens   BrowserCaptureToken[]
  applicationAnswers     ApplicationAnswer[]
  interviewQuestions     InterviewQuestion[]
  starStories            StarStory[]
  aiSettings             AISettings?
  aiUsageEvents          AIUsageEvent[]
  aiBudgetLedgers        AIBudgetLedger[]
  aiBudgetReservations   AIBudgetReservation[]
  aiResponseCaches       AIResponseCache[]
  jobDiscoveryPreference JobDiscoveryPreference?

  applicationAutomationPolicy ApplicationAutomationPolicy?
  applicationRuns             ApplicationRun[]
  applicationRunFormInspections ApplicationRunFormInspection[]
  applicationRunAnswerPackets   ApplicationRunAnswerPacket[]
  applicationRunAnswers       ApplicationRunAnswer[]
  applicationRunSteps         ApplicationRunStep[]
  applicationExecutionTokens  ApplicationExecutionToken[]
}

model UserProfile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  location               String           @default("")
  careerGoals            String?
  preferredRoles         String[]
  preferredLocations     String[]
  remotePreference       RemotePreference @default(FLEXIBLE)
  salaryTargetMin        Int?
  salaryTargetMax        Int?
  industriesOfInterest   String[]
  dealBreakers           String[]
  skillsToEmphasize      String[]
  skillsNotToExaggerate  String[]
  workAuthorizationNotes String?
  availabilityNotes      String?
  preferredResumeTone    String           @default("clear, honest, concise, role-specific")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobDiscoveryPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetSearches String[] @default([])
  location       String   @default("")
  limitPerQuery  Int      @default(8)
  remoteOnly     Boolean  @default(false)
  scoreImported  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id             String    @id @default(cuid())
  userId         String
  title          String
  isMaster       Boolean   @default(false)
  originalName   String?
  filePath       String?
  mimeType       String?
  rawText        String?
  contactInfo    Json?
  summary        String?
  skills         String[]
  workHistory    Json?
  projects       Json?
  education      Json?
  certifications Json?
  achievements   String[]
  parsedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId, isMaster])
}

model ResumeVersion {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String?
  jobPostingId     String?
  applicationId    String?
  title            String
  summary          String?
  skills           String[]
  bullets          Json?
  fullText         String
  changeNotes      String?
  atsCompatibility Int?
  jobFitScore      Int?
  filePathDocx     String?
  filePathPdf      String?
  template         String   @default("CLASSIC")
  pageSize         String   @default("LETTER")
  fontFamily       String   @default("ARIAL")
  accentColor      String   @default("#0F766E")
  fontSize         Int      @default(10)
  lineSpacing      Int      @default(115)
  createdAt        DateTime @default(now())

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume             Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobPosting         JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application        Application?     @relation("ResumeVersionsForApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  usedByApplications Application[]    @relation("ApplicationResumeUsed")
  applicationRuns    ApplicationRun[]
}

model StoredFile {
  id          String   @id @default(cuid())
  userId      String
  category    String
  filename    String
  contentType String?
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([createdAt])
}

model JobSource {
  id             String        @id @default(cuid())
  userId         String
  name           String
  type           JobSourceType
  baseUrl        String?
  boardToken     String?
  allowlisted    Boolean       @default(false)
  robotsChecked  Boolean       @default(false)
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  syncEnabled    Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostings JobPosting[]

  @@index([userId, type])
  @@index([userId, syncEnabled])
}

model JobPosting {
  id                        String        @id @default(cuid())
  userId                    String
  jobSourceId               String?
  title                     String
  normalizedTitle           String
  company                   String
  normalizedCompany         String
  location                  String?
  normalizedLocation        String
  remoteStatus              String?
  salaryMin                 Int?
  salaryMax                 Int?
  salaryCurrency            String        @default("USD")
  datePosted                DateTime?
  sourceUrl                 String
  applyUrl                  String?
  normalizedApplyUrl        String
  description               String
  requirements              String[]
  preferredQualifications   String[]
  benefits                  String[]
  detectedTechStack         String[]
  seniorityLevel            String?
  companySize               String?
  sourceType                JobSourceType
  firstDiscoveredAt         DateTime      @default(now())
  lastCheckedAt             DateTime?
  status                    PostingStatus @default(ACTIVE)
  overallFitScore           Int?
  resumeKeywordScore        Int?
  skillsMatchScore          Int?
  experienceMatchScore      Int?
  careerGoalScore           Int?
  locationWorkStyleScore    Int?
  compensationScore         Int?
  confidenceScore           Int?
  keyMatchReason            String?
  matchRecommendation       String?
  missingKeywords           String[]
  supportedKeywords         String[]
  suggestedResumeAngle      String?
  suggestedCoverLetterAngle String?
  concerns                  String[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobSource          JobSource?          @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  applications       Application[]
  contacts           Contact[]
  emails             EmailMessage[]
  interviews         Interview[]
  resumeVersions     ResumeVersion[]
  generatedDocs      GeneratedDocument[]
  aiAnalyses         AIAnalysis[]
  interviewQuestions InterviewQuestion[]
  tasks              Task[]
  reminders          FollowUpReminder[]
  applicationRuns    ApplicationRun[]

  @@unique([userId, normalizedCompany, normalizedTitle, normalizedLocation, normalizedApplyUrl], map: "job_dedupe_unique")
  @@index([userId, status])
  @@index([userId, overallFitScore])
  @@index([userId, datePosted])
}

model Application {
  id                   String            @id @default(cuid())
  userId               String
  jobPostingId         String
  status               ApplicationStatus @default(SAVED)
  dateSaved            DateTime          @default(now())
  dateApplied          DateTime?
  resumeVersionId      String?
  coverLetterVersionId String?
  contactName          String?
  contactEmail         String?
  followUpDueAt        DateTime?
  nextAction           String?
  notes                String?
  outcome              String?
  lessonsLearned       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting         JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resumeVersion      ResumeVersion?      @relation("ApplicationResumeUsed", fields: [resumeVersionId], references: [id], onDelete: SetNull)
  coverLetterVersion GeneratedDocument?  @relation("ApplicationCoverLetter", fields: [coverLetterVersionId], references: [id], onDelete: SetNull)
  resumeVersions     ResumeVersion[]     @relation("ResumeVersionsForApplication")
  generatedDocs      GeneratedDocument[] @relation("GeneratedDocumentsForApplication")
  events             ApplicationEvent[]
  contacts           Contact[]
  emails             EmailMessage[]
  interviews         Interview[]
  tasks              Task[]
  reminders          FollowUpReminder[]
  applicationRuns    ApplicationRun[]

  @@unique([userId, jobPostingId])
  @@index([userId, status])
  @@index([userId, followUpDueAt])
}

model ApplicationEvent {
  id            String    @id @default(cuid())
  userId        String
  applicationId String
  type          EventType
  title         String
  body          String?
  metadata      Json?
  occurredAt    DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

model Contact {
  id            String   @id @default(cuid())
  userId        String
  jobPostingId  String?
  applicationId String?
  name          String
  email         String?
  company       String?
  role          String?
  profileUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?    @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emails      EmailMessage[]

  @@index([userId, email])
}

model EmailMessage {
  id              String         @id @default(cuid())
  userId          String
  jobPostingId    String?
  applicationId   String?
  contactId       String?
  gmailMessageId  String?
  threadId        String?
  direction       EmailDirection @default(INBOUND)
  fromEmail       String?
  toEmail         String?
  subject         String
  snippet         String?
  body            String?
  bodySaved       Boolean        @default(false)
  receivedAt      DateTime?
  sentAt          DateTime?
  labels          String[]
  aiSummary       String?
  requestedAction String?
  draftResponse   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt])
}

model Interview {
  id                 String        @id @default(cuid())
  userId             String
  jobPostingId       String?
  applicationId      String?
  type               InterviewType
  scheduledAt        DateTime?
  durationMinutes    Int?
  locationOrLink     String?
  interviewerNames   String[]
  interviewerUrls    String[]
  prepBrief          String?
  likelyQuestions    String[]
  starStories        Json?
  consentStatus      ConsentStatus @default(NOT_APPLICABLE)
  notes              String?
  followUpEmailDraft String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting      JobPosting?          @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application     Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  notesList       InterviewNote[]
  recordings      InterviewRecording[]
  aiAnalyses      AIAnalysis[]
  questionLibrary InterviewQuestion[]
}

model InterviewNote {
  id          String   @id @default(cuid())
  interviewId String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model InterviewRecording {
  id                 String        @id @default(cuid())
  interviewId        String
  filePath           String?       @unique
  transcript         String?
  consentConfirmedAt DateTime?
  consentStatement   String?
  consentStatus      ConsentStatus @default(CONSENT_CONFIRMED)
  createdAt          DateTime      @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model GeneratedDocument {
  id            String       @id @default(cuid())
  userId        String
  jobPostingId  String?
  applicationId String?
  type          DocumentType
  title         String
  content       String
  format        String       @default("markdown")
  filePath      String?
  versionLabel  String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting           JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application          Application?     @relation("GeneratedDocumentsForApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  usedAsCoverLetterFor Application[]    @relation("ApplicationCoverLetter")
  applicationRuns      ApplicationRun[]

  @@index([userId, type])
}

model AIAnalysis {
  id            String         @id @default(cuid())
  userId        String
  jobPostingId  String?
  interviewId   String?
  type          AIAnalysisType
  model         String
  promptName    String
  promptVersion String         @default("1")
  inputHash     String?
  input         Json
  output        Json
  confidence    Int?
  createdAt     DateTime       @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  interview  Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, type, inputHash])
}

model BrowserCaptureToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ApplicationAnswer {
  id                 String   @id @default(cuid())
  userId             String
  category           String
  question           String
  normalizedQuestion String
  answer             String
  sensitive          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedQuestion])
  @@index([userId, category, isActive])
}

model InterviewQuestion {
  id                 String    @id @default(cuid())
  userId             String
  jobPostingId       String?
  interviewId        String?
  question           String
  normalizedQuestion String
  category           String    @default("GENERAL")
  answer             String?
  improvedAnswer     String?
  tags               String[]  @default([])
  timesAsked         Int       @default(0)
  lastAskedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  interview  Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@unique([userId, normalizedQuestion])
  @@index([userId, category])
  @@index([userId, lastAskedAt])
}

model StarStory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  situation   String
  task        String
  action      String
  result      String
  skills      String[] @default([])
  roleContext String?
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isFavorite])
}

model AISettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  monthlyBudgetCents    Int      @default(500)
  automationBudgetCents Int      @default(150)
  maxAnalysesPerSync    Int      @default(5)
  aiDiscoveryEnabled    Boolean  @default(false)
  modelOverride         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIUsageEvent {
  id                  String   @id @default(cuid())
  userId              String
  reservationId       String?  @unique
  provider            String   @default("openai")
  feature             String
  model               String
  promptName          String
  promptVersion       String   @default("1")
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cachedInputTokens   Int      @default(0)
  estimatedCostMicros Int?
  requestHash         String?
  status              String
  automation          Boolean  @default(false)
  errorCode           String?
  createdAt           DateTime @default(now())

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation AIBudgetReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, feature, requestHash])
}

model AIBudgetLedger {
  id                        String   @id @default(cuid())
  userId                    String
  monthStart                DateTime
  budgetMicros              Int
  spentMicros               Int      @default(0)
  reservedMicros            Int      @default(0)
  remainingMicros           Int
  automationBudgetMicros    Int
  automationSpentMicros     Int      @default(0)
  automationReservedMicros  Int      @default(0)
  automationRemainingMicros Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations AIBudgetReservation[]

  @@unique([userId, monthStart])
  @@index([userId, updatedAt])
}

model AIBudgetReservation {
  id                String    @id @default(cuid())
  userId            String
  ledgerId          String
  provider          String
  model             String
  feature           String
  promptName        String
  promptVersion     String    @default("1")
  requestHash       String
  dedupeKey         String?   @unique
  maximumCostMicros Int
  actualCostMicros  Int?
  automation        Boolean   @default(false)
  status            String    @default("RESERVED")
  errorCode         String?
  createdAt         DateTime  @default(now())
  reconciledAt      DateTime?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger     AIBudgetLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  usageEvent AIUsageEvent?

  @@index([userId, createdAt])
  @@index([ledgerId, status])
  @@index([userId, feature, requestHash])
}

model AIResponseCache {
  id            String    @id @default(cuid())
  userId        String
  provider      String
  model         String
  promptName    String
  promptVersion String    @default("1")
  requestHash   String
  output        Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, model, promptName, promptVersion, requestHash], map: "ai_response_cache_key")
  @@index([userId, expiresAt])
}

model ApplicationAutomationPolicy {
  id                     String                @id @default(cuid())
  userId                 String                @unique
  enabled                Boolean               @default(false)
  mode                   AutomationMode        @default(PREPARE_ONLY)
  minimumFitScore        Int                   @default(85)
  minimumConfidenceScore Int                   @default(85)
  dailyApplicationCap    Int                   @default(5)
  allowedHosts           String[]              @default([])
  blockedHosts           String[]              @default([])
  permittedAdapters      String[]              @default([])
  coverLetterRequired    Boolean               @default(true)
  sensitiveAnswerPolicy  SensitiveAnswerPolicy @default(EXCLUDE)
  finalReviewRequired    Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicationRun {
  id                             String              @id @default(cuid())
  userId                         String
  jobPostingId                   String
  applicationId                  String
  state                          ApplicationRunState @default(DRAFT)
  idempotencyKey                 String
  activeRunKey                   String?             @unique
  stateVersion                   Int                 @default(0)
  currentFormInspectionVersion   Int                 @default(0)
  currentAnswerPacketVersion     Int                 @default(0)
  prepareAttemptId               String?
  prepareLeaseExpiresAt          DateTime?
  fillAttemptId                  String?
  fillLeaseExpiresAt             DateTime?
  firstPreparingAt               DateTime?
  applyUrlSnapshot               String
  applyHost                      String
  detectedAdapter                String?
  policySnapshot                 Json?
  policyHash                     String?
  fitScoreSnapshot               Int?
  matchConfidenceScoreSnapshot   Int?
  plannerConfidenceScoreSnapshot Int?
  resumeVersionId                String?
  resumeContentHash              String?
  coverLetterVersionId           String?
  coverLetterContentHash         String?
  applicationPlanSnapshot        Json?
  requirementCatalogSnapshot     Json?
  evidenceCatalogSnapshot        Json?
  plannerProvider                String?
  plannerModel                   String?
  plannerPromptVersion           String?
  plannerRequestHash             String?
  reviewReasons                  String[]            @default([])
  reviewAcknowledgedAt           DateTime?
  blockingReason                 String?
  errorCategory                  String?
  preparedAt                     DateTime?
  completedAt                    DateTime?
  cancelledAt                    DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting         JobPosting                  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  application        Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeVersion      ResumeVersion?              @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  coverLetterVersion GeneratedDocument?          @relation(fields: [coverLetterVersionId], references: [id], onDelete: SetNull)
  formInspections   ApplicationRunFormInspection[]
  answerPackets     ApplicationRunAnswerPacket[]
  answers            ApplicationRunAnswer[]
  steps              ApplicationRunStep[]
  executionTokens    ApplicationExecutionToken[]

  @@unique([userId, idempotencyKey])
  @@index([userId, state])
  @@index([userId, firstPreparingAt])
  @@index([userId, createdAt])
}

model ApplicationRunFormInspection {
  id                 String   @id @default(cuid())
  runId              String
  userId             String
  version            Int
  schemaVersion      Int
  normalizerVersion  Int
  classifierVersion  Int
  fingerprintVersion Int
  formFingerprint    String
  normalizedSnapshot Json
  createdAt          DateTime @default(now())

  run           ApplicationRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerPackets ApplicationRunAnswerPacket[]

  @@unique([runId, version])
  @@index([userId, runId])
}

model ApplicationRunAnswerPacket {
  id               String   @id @default(cuid())
  runId            String
  userId           String
  version          Int
  formInspectionId String
  schemaVersion    Int
  builderVersion   Int
  policyHash       String
  inputHash        String
  packetHash       String
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  run            ApplicationRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  formInspection ApplicationRunFormInspection @relation(fields: [formInspectionId], references: [id], onDelete: Cascade)
  answers        ApplicationRunAnswer[]

  @@unique([runId, version])
  @@index([userId, runId])
  @@index([formInspectionId])
}

model ApplicationRunAnswer {
  id                 String                       @id @default(cuid())
  runId              String
  userId             String
  answerPacketId     String?
  normalizedFieldKey String
  originalQuestion   String
  normalizedQuestion String?
  fieldFingerprint   String?
  semanticFieldKey   String?
  fieldType          ApplicationFormFieldType?
  classification     ApplicationQuestionClassification?
  disposition        ApplicationAnswerDisposition?
  dispositionReason  ApplicationAnswerDispositionReason?
  proposedValue      String?
  proposal           Json?
  valueRedacted      Boolean                      @default(false)
  sourceType         ApplicationAnswerSourceType?
  sourceIds          String[]                     @default([])
  evidenceIds        String[]                     @default([])
  sourceFingerprint  String?
  confidence         Int                          @default(0)
  sensitive          Boolean                      @default(false)
  required           Boolean                      @default(false)
  requiresReview     Boolean                      @default(true)
  status             ApplicationRunAnswerStatus   @default(PENDING)
  reviewedByUser     Boolean                      @default(false)
  reviewedAt         DateTime?
  finalValueHash     String?
  reviewHashVersion  ApplicationAnswerReviewHashVersion?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  run          ApplicationRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerPacket ApplicationRunAnswerPacket? @relation(fields: [answerPacketId], references: [id], onDelete: Cascade)

  @@unique([answerPacketId, normalizedFieldKey])
  @@index([runId])
  @@index([userId, runId])
}

model ApplicationRunStep {
  id                   String                   @id @default(cuid())
  runId                String
  userId               String
  stepKey              String
  sequence             Int
  action               String
  semanticFieldKey     String?
  adapter              String?
  status               ApplicationRunStepStatus @default(PENDING)
  attemptNumber        Int                      @default(1)
  redactedValueSummary String?
  errorCategory        String?
  artifactReference    String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  run  ApplicationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey, attemptNumber])
  @@index([runId, sequence])
  @@index([userId, runId])
}

model ApplicationExecutionToken {
  id          String                    @id @default(cuid())
  userId      String
  runId       String
  tokenHash   String                    @unique
  tokenPrefix String
  host        String
  scope       ApplicationExecutionScope
  singleUse   Boolean                   @default(true)
  consumedAt  DateTime?
  lastUsedAt  DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime                  @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  ApplicationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, runId])
  @@index([expiresAt])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  jobPostingId  String?
  applicationId String?
  title         String
  description   String?
  status        TaskStatus   @default(OPEN)
  priority      TaskPriority @default(MEDIUM)
  dueAt         DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
}

model FollowUpReminder {
  id            String    @id @default(cuid())
  userId        String
  jobPostingId  String?
  applicationId String?
  title         String
  dueAt         DateTime
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, dueAt])
}

model GmailIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  googleAccountEmail    String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  scope                 String
  tokenExpiresAt        DateTime?
  connectedAt           DateTime  @default(now())
  disconnectedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
