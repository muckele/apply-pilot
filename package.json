{
  "name": "apply-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted job discovery and controlled application workflows that keep you in control.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "browser:install": "playwright install chromium",
    "application-browser": "tsx scripts/application-browser-companion.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 tests/browser/*.test.ts",
    "test:postgres": "tsx scripts/run-postgres-tests.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "ai:evaluate": "tsx evaluation/ai-provider-evaluation.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.0",
    "docx": "^8.5.0",
    "googleapis": "^174.0.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "playwright": "1.62.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
