# Apply Pilot local environment. Copy to .env and fill in what you need.
# Placeholders only: never commit real keys, secrets, emails or remote database URLs.
# Labels: [required] always needed; [required in production] checked by /api/health
# deployment readiness; [optional] has a safe default; [local only] never set in production.
# Platform variables (NODE_ENV, NEXT_RUNTIME, VERCEL*, CI) are set by the runtime, not here.

# --- Database ---------------------------------------------------------------
# [required] Pooled PostgreSQL URL used by the app at runtime. Keep it on localhost for development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_local_dev?schema=public"
# [required] Direct (non-pooled) URL Prisma uses for migrations; must be the same local database.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_local_dev?schema=public"

# --- Auth (Auth.js) ---------------------------------------------------------
# [required in production] Random secret for Auth.js and OAuth state signing.
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# [required in production] Canonical app origin for Auth.js.
AUTH_URL="http://localhost:3000"
# [required in production] Legacy Auth.js origin; deployment readiness checks it matches AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"
# [required in production] Google OAuth client id for sign-in and Gmail.
GOOGLE_CLIENT_ID=""
# [required in production] Google OAuth client secret.
GOOGLE_CLIENT_SECRET=""
# [required in production] Comma-separated sign-in allowlist. Empty allows any account locally
# but blocks production sign-in unless AUTH_ALLOW_PUBLIC_SIGNUPS="true".
AUTH_ALLOWED_EMAILS=""
# [optional] "true" opens sign-in to any Google account. Keep "false" for a private deployment.
AUTH_ALLOW_PUBLIC_SIGNUPS="false"

# --- App --------------------------------------------------------------------
# [required in production] Canonical app origin used for links and OAuth redirects.
APP_BASE_URL="http://localhost:3000"
# [optional] Version label shown in /api/health when VERCEL_GIT_COMMIT_SHA is not set.
APP_VERSION="local"
# [optional] Log threshold: debug, info, warn or error.
LOG_LEVEL="debug"

# --- Local demo fallback ----------------------------------------------------
# [local only] "true" lets requests without a session act as the fictional demo user. Ignored in production.
ALLOW_DEMO_USER="false"
# [optional] User id for the demo fallback and the local seed.
DEFAULT_DEMO_USER_ID="demo-user"

# --- AI: Gemini (the single MVP provider, decision D029) ---------------------
# [required for AI features] Paid-AI master switch; "true" enables provider calls.
AI_ENABLED="false"
# [optional] Global provider: gemini (default) or legacy openai.
AI_PROVIDER="gemini"
# [optional] "true" forces local mock behaviour and blocks paid calls.
AI_MOCK_MODE="true"
# [required for AI features] Gemini API key (resume parsing, job match, tailored resume, cover letter).
GEMINI_API_KEY=""
# [optional] Fast-tier Gemini model override for configurable features; empty uses the code default.
GEMINI_FAST_MODEL=""
# [optional] Quality-tier Gemini model override for configurable features; empty uses the code default.
GEMINI_QUALITY_MODEL=""
# [optional] Comma-separated models users may pick; unset falls back to OPENAI_ALLOWED_MODELS.
# AI_ALLOWED_MODELS=""
# [optional] Per-feature provider routing, e.g. "APPLICATION_PLAN:kimi". Only APPLICATION_PLAN is eligible.
AI_PROVIDER_OVERRIDES=""

# --- AI cost caps (values above the compiled ceilings are clamped down) -------
# [optional] Per-user monthly hard cap in cents for guarded AI calls (ceiling 500).
AI_HARD_CAP_CENTS="500"
# [optional] Monthly cap in cents for automated, non-interactive AI work (ceiling 150).
AI_AUTOMATION_CAP_CENTS="150"
# [optional] Maximum estimated cost of a single AI request in cents (ceiling 10).
AI_MAX_REQUEST_COST_CENTS="10"
# [optional] Interactive requests estimated above this many cents need user confirmation (ceiling 5).
AI_CONFIRMATION_THRESHOLD_CENTS="5"

# --- AI: legacy and non-MVP providers -----------------------------------------
# [optional] Legacy OpenAI key for explicit resume-parser compatibility only.
OPENAI_API_KEY=""
# [optional] Default legacy OpenAI model.
OPENAI_MODEL="gpt-4o-mini"
# [optional] Comma-separated legacy OpenAI models users may select.
OPENAI_ALLOWED_MODELS="gpt-4o-mini"
# [optional] "true" returns deterministic local output instead of calling OpenAI.
OPENAI_MOCK_MODE="true"
# [optional] Legacy OpenAI input price per 1M tokens in USD, for soft budget estimates.
OPENAI_INPUT_COST_PER_1M_USD=""
# [optional] Legacy OpenAI output price per 1M tokens in USD.
OPENAI_OUTPUT_COST_PER_1M_USD=""
# [optional] Legacy OpenAI cached-input price per 1M tokens in USD; defaults to the input price.
OPENAI_CACHED_INPUT_COST_PER_1M_USD=""
# [optional] Moonshot key for Kimi; reachable only through AI_PROVIDER_OVERRIDES, not on the MVP path.
MOONSHOT_API_KEY=""
# [optional] Kimi model override; empty uses the code default.
KIMI_MODEL=""
# [optional] Kimi reasoning effort: low (default), high or max.
KIMI_REASONING_EFFORT="low"

# --- Controlled application automation ----------------------------------------
# [optional] Global emergency stop; only exactly "true" permits assisted Fill. Keep "false" by default.
APPLICATION_AUTOMATION_ENABLED="false"

# --- Gmail integration and token encryption ----------------------------------
# [required in production] Gmail OAuth callback; must be <APP_BASE_URL>/api/gmail/callback.
GMAIL_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
# [optional] Gmail OAuth scopes; read-only by default.
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly"
# [required in production] Base64-encoded 32-byte key that encrypts stored OAuth tokens.
TOKEN_ENCRYPTION_KEY=""

# --- Job discovery sources ---------------------------------------------------
# [optional] USAJOBS API key (federal jobs).
USAJOBS_API_KEY=""
# [optional] Email registered with USAJOBS; required by USAJOBS when the key is set.
USAJOBS_USER_AGENT=""
# [optional] Workable API token for an approved Workable account.
WORKABLE_API_TOKEN=""
# [optional] Adzuna app id; commercial use needs an Adzuna licence.
ADZUNA_APP_ID=""
# [optional] Adzuna app key.
ADZUNA_APP_KEY=""
# [optional] Adzuna country code.
ADZUNA_COUNTRY="us"
# [optional] TheirStack API key; paid, may consume credits per returned job.
THEIRSTACK_API_KEY=""
# [optional] TheirStack freshness window in days.
THEIRSTACK_POSTED_MAX_AGE_DAYS="30"
# [optional] SerpApi key for Google Jobs; paid, may consume credits per search.
SERPAPI_API_KEY=""
# [optional] Cap on paid SerpApi searches per discovery run.
SERPAPI_MAX_QUERIES_PER_RUN="3"
# [optional] Skip postings older than this many days before import.
JOB_SOURCE_MAX_POSTED_AGE_DAYS="30"
# [optional] Enables Remotive discovery; off until its terms are cleared.
# compliance: see MVP Bible §6
JOB_SOURCE_REMOTIVE_ENABLED="false"
# [optional] Enables Adzuna discovery; off until licensed for this use.
# compliance: see MVP Bible §6
JOB_SOURCE_ADZUNA_ENABLED="false"

# --- Scheduled discovery (cron) ----------------------------------------------
# [required in production] Bearer token the scheduled job-discovery route requires.
CRON_SECRET="replace-with-a-random-long-secret"
# [optional] Maximum source syncs per cron invocation (1-100).
CRON_MAX_SOURCES_PER_RUN="10"
# [optional] Skip sources synced more recently than this many minutes.
CRON_MIN_SOURCE_INTERVAL_MINUTES="360"
# [optional] Treat a RUNNING sync as stale after this many minutes.
CRON_RUNNING_LOCK_MINUTES="30"

# --- File storage --------------------------------------------------------------
# [optional] "local" (ignored uploads/ folder) for development, "database" for production.
FILE_STORAGE_DRIVER="local"
# [optional] Resume upload limit in MB; keep at 4 or below on Vercel.
MAX_UPLOAD_MB="4"
# [optional] Interview audio upload limit in MB through the app route; keep at 4 or below on Vercel.
MAX_AUDIO_UPLOAD_MB="4"
# [optional] Private Vercel Blob token; when set, interview audio uploads go straight to Blob storage.
BLOB_READ_WRITE_TOKEN=""
# [optional] Maximum direct-to-Blob audio upload size in MB.
MAX_DIRECT_AUDIO_UPLOAD_MB="25"

# --- Local-only tooling (export per command; never set in production) -----------
# These stay commented out: TEST_DATABASE_URL must be unset for migrate and seed,
# and the guarded scripts refuse anything but a disposable localhost database.
# [local only] Must be exactly "1" for `npm run prisma:migrate` and `npm run prisma:seed`.
# APPLY_PILOT_LOCAL_DESTRUCTIVE="1"
# [local only] Guarded migrate/seed target; must be localhost database apply_pilot_local_dev.
# LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_local_dev?schema=public"
# [local only] Direct URL for the same local database.
# LOCAL_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_local_dev?schema=public"
# [local only] `npm run test:postgres` target; localhost database apply_pilot_commit5_test only, never Neon.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_commit5_test?schema=public"
# [local only] Must be exactly "1" for the guarded PostgreSQL test runner.
# COMMIT5_POSTGRES_TEST="1"
# [local only] Must be exactly "1" to run the read-only legacy answer audit script.
# APPLICATION_RUN_ANSWER_LEGACY_AUDIT="1"
# [local only] Database the read-only legacy answer audit reads.
# APPLICATION_RUN_ANSWER_LEGACY_AUDIT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apply_pilot_local_dev?schema=public"
# [local only] "true" shows the synthetic evidence-correction preview page (never in production).
# APPLY_PILOT_SYNTHETIC_EVIDENCE_PREVIEW="false"
# [local only] "true" adds generated documents to the synthetic evidence preview.
# APPLY_PILOT_SYNTHETIC_GENERATED_DOCUMENTS_PREVIEW="false"
# [local only] "true" shows the synthetic one-job preview page (never in production).
# APPLY_PILOT_SYNTHETIC_ONE_JOB_PREVIEW="false"
