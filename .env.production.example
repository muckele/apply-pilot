# Apply Pilot production environment: the source of truth for hosting-provider settings.
# Configure values in the hosting dashboard or CLI, never in Git. Placeholders only.
# Labels: [required] always needed; [required in production] checked by /api/health
# deployment readiness; [optional] has a safe default.
# Platform variables (NODE_ENV, NEXT_RUNTIME, VERCEL*, CI) are set by the runtime, not here.
#
# Never set in production (local-only tooling, documented in .env.example):
# APPLY_PILOT_LOCAL_DESTRUCTIVE, LOCAL_DATABASE_URL, LOCAL_DIRECT_URL, TEST_DATABASE_URL,
# COMMIT5_POSTGRES_TEST, APPLICATION_RUN_ANSWER_LEGACY_AUDIT,
# APPLICATION_RUN_ANSWER_LEGACY_AUDIT_DATABASE_URL and the APPLY_PILOT_SYNTHETIC_*_PREVIEW flags.

# --- Database ---------------------------------------------------------------
# [required] Pooled PostgreSQL URL used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
# [required] Direct (non-pooled) URL for forward-only `prisma migrate deploy`, run only with explicit owner approval.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST.neon.tech/DB?sslmode=require"

# --- Auth (Auth.js) ---------------------------------------------------------
# [required in production] Strong random secret for Auth.js and OAuth state signing.
AUTH_SECRET="generate-a-strong-production-secret"
# [required in production] Canonical production origin for Auth.js.
AUTH_URL="https://your-production-domain.com"
# [required in production] Must equal AUTH_URL.
NEXTAUTH_URL="https://your-production-domain.com"
# [required in production] Google OAuth client id.
GOOGLE_CLIENT_ID=""
# [required in production] Google OAuth client secret.
GOOGLE_CLIENT_SECRET=""
# [required in production] Comma-separated sign-in allowlist for the private deployment.
AUTH_ALLOWED_EMAILS="you@example.com"
# [optional] Keep "false" so only allowlisted accounts can sign in.
AUTH_ALLOW_PUBLIC_SIGNUPS="false"

# --- App --------------------------------------------------------------------
# [required in production] Canonical production origin; must equal AUTH_URL.
APP_BASE_URL="https://your-production-domain.com"
# [optional] Version label for /api/health when VERCEL_GIT_COMMIT_SHA is not set.
APP_VERSION=""
# [optional] Log threshold: debug, info, warn or error.
LOG_LEVEL="info"

# --- Local demo fallback ----------------------------------------------------
# [optional] Keep "false". The demo fallback is ignored in production even if set.
ALLOW_DEMO_USER="false"
# [optional] Demo user id; unused in production.
DEFAULT_DEMO_USER_ID="demo-user"

# --- AI: Gemini (the single MVP provider, decision D029) ---------------------
# [required for AI features] Paid-AI master switch.
AI_ENABLED="true"
# [optional] Leave unset or "gemini"; any other value turns AI features off.
AI_PROVIDER="gemini"
# [optional] Must be "false" for real provider calls.
AI_MOCK_MODE="false"
# [required for AI features] Gemini API key.
GEMINI_API_KEY=""
# [optional] Fast-tier Gemini model override; empty uses the code default.
GEMINI_FAST_MODEL=""
# [optional] Quality-tier Gemini model override; empty uses the code default.
GEMINI_QUALITY_MODEL=""
# [optional] Comma-separated models users may pick; each must be in the Gemini price registry.
# AI_ALLOWED_MODELS=""
# [retired] No longer read; /api/health readiness warns while it is still set. Delete it.
# AI_PROVIDER_OVERRIDES=""

# --- AI cost caps (values above the compiled ceilings are clamped down) -------
# [optional] Per-user monthly hard cap in cents for guarded AI calls (ceiling 500).
AI_HARD_CAP_CENTS="500"
# [optional] Monthly cap in cents for automated, non-interactive AI work (ceiling 150).
AI_AUTOMATION_CAP_CENTS="150"
# [optional] Maximum estimated cost of a single AI request in cents (ceiling 15).
AI_MAX_REQUEST_COST_CENTS="15"
# [optional] Interactive requests estimated above this many cents need user confirmation (ceiling 5).
AI_CONFIRMATION_THRESHOLD_CENTS="5"

# OPENAI_*, MOONSHOT_API_KEY and KIMI_* are retired (decision D029); delete them from the host.

# --- Controlled application automation ----------------------------------------
# [optional] Global emergency stop; deploy with "false" and enable only with owner approval.
APPLICATION_AUTOMATION_ENABLED="false"

# --- Gmail integration and token encryption ----------------------------------
# [required in production] Must be <APP_BASE_URL>/api/gmail/callback.
GMAIL_REDIRECT_URI="https://your-production-domain.com/api/gmail/callback"
# [optional] Gmail OAuth scopes; read-only.
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly"
# [required in production] Base64-encoded 32-byte key that encrypts stored OAuth tokens.
TOKEN_ENCRYPTION_KEY=""

# --- Job discovery sources ---------------------------------------------------
# [optional] USAJOBS API key.
USAJOBS_API_KEY=""
# [optional] Email registered with USAJOBS.
USAJOBS_USER_AGENT=""
# [optional] Workable API token.
WORKABLE_API_TOKEN=""
# [optional] Adzuna app id; commercial use needs an Adzuna licence.
ADZUNA_APP_ID=""
# [optional] Adzuna app key.
ADZUNA_APP_KEY=""
# [optional] Adzuna country code.
ADZUNA_COUNTRY="us"
# [optional] TheirStack API key; paid, off by default.
THEIRSTACK_API_KEY=""
# [optional] TheirStack freshness window in days.
THEIRSTACK_POSTED_MAX_AGE_DAYS="30"
# [optional] SerpApi key; paid, off by default.
SERPAPI_API_KEY=""
# [optional] Cap on paid SerpApi searches per discovery run.
SERPAPI_MAX_QUERIES_PER_RUN="3"
# [optional] Skip postings older than this many days before import.
JOB_SOURCE_MAX_POSTED_AGE_DAYS="30"
# [optional] Maximum followed and seeded ATS boards checked per discovery run (1-100, default 40).
JOB_DISCOVERY_MAX_BOARDS_PER_RUN="40"
# [optional] Enables Remotive discovery; off until its terms are cleared.
# compliance: see MVP Bible §6
JOB_SOURCE_REMOTIVE_ENABLED="false"
# [optional] Enables Adzuna discovery; off until licensed for this use.
# compliance: see MVP Bible §6
JOB_SOURCE_ADZUNA_ENABLED="false"

# --- Scheduled discovery (cron) ----------------------------------------------
# [required in production] Bearer token the scheduled job-discovery route requires.
CRON_SECRET="generate-a-random-long-cron-secret"
# [optional] Maximum source syncs per cron invocation (1-100).
CRON_MAX_SOURCES_PER_RUN="10"
# [optional] Skip sources synced more recently than this many minutes.
CRON_MIN_SOURCE_INTERVAL_MINUTES="360"
# [optional] Treat a RUNNING sync as stale after this many minutes.
CRON_RUNNING_LOCK_MINUTES="30"

# --- File storage --------------------------------------------------------------
# [optional] "database" is durable for the private MVP.
FILE_STORAGE_DRIVER="database"
# [optional] Resume upload limit in MB; readiness fails above 4 on Vercel.
MAX_UPLOAD_MB="4"
# [optional] Interview audio upload limit in MB through the app route; readiness fails above 4.
MAX_AUDIO_UPLOAD_MB="4"
# [optional] Private Vercel Blob token for direct interview audio uploads.
BLOB_READ_WRITE_TOKEN=""
# [optional] Maximum direct-to-Blob audio upload size in MB.
MAX_DIRECT_AUDIO_UPLOAD_MB="25"
