# Production database
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST.neon.tech/DB?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-strong-production-secret"
AUTH_URL="https://your-production-domain.com"
NEXTAUTH_URL="https://your-production-domain.com"
APP_BASE_URL="https://your-production-domain.com"
APP_VERSION=""
LOG_LEVEL="info"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_ALLOWED_EMAILS="approved.user@example.test"
AUTH_ALLOW_PUBLIC_SIGNUPS="false"

# Disable local demo fallback in production.
ALLOW_DEMO_USER="false"
DEFAULT_DEMO_USER_ID="demo-user"

# Controlled application automation
# Keep false until the backend policy and reviewed host allowlist are configured.
APPLICATION_AUTOMATION_ENABLED="false"

# Provider-neutral paid AI. Enable only after the controlled evaluation passes.
AI_ENABLED="false"
AI_PROVIDER="gemini"
AI_MOCK_MODE="false"
AI_ALLOWED_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash-lite"
AI_HARD_CAP_CENTS="500"
AI_AUTOMATION_CAP_CENTS="150"
AI_MAX_REQUEST_COST_CENTS="10"
AI_CONFIRMATION_THRESHOLD_CENTS="5"
AI_EVALUATION_ACKNOWLEDGED="false"
GEMINI_API_KEY=""
GEMINI_FAST_MODEL="gemini-3.5-flash-lite"
GEMINI_QUALITY_MODEL="gemini-3.5-flash-lite"

# Optional Kimi (Moonshot) provider for feature-routed planning. Server-only key.
# Endpoint is fixed in code to https://api.moonshot.ai/v1. Only APPLICATION_PLAN may route here.
MOONSHOT_API_KEY=""
KIMI_MODEL="kimi-k3"
KIMI_REASONING_EFFORT="low"
AI_PROVIDER_OVERRIDES=""

# Optional OpenAI provider compatibility.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_ALLOWED_MODELS="gpt-4o-mini"
OPENAI_MOCK_MODE="false"

# Gmail OAuth integration
GMAIL_REDIRECT_URI="https://your-production-domain.com/api/gmail/callback"
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly"

# Automated job discovery
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT=""
WORKABLE_API_TOKEN=""
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="us"
THEIRSTACK_API_KEY=""
THEIRSTACK_POSTED_MAX_AGE_DAYS="30"
SERPAPI_API_KEY=""
SERPAPI_MAX_QUERIES_PER_RUN="3"
JOB_SOURCE_MAX_POSTED_AGE_DAYS="30"
CRON_SECRET="generate-a-random-long-cron-secret"
CRON_MAX_SOURCES_PER_RUN="10"
CRON_MIN_SOURCE_INTERVAL_MINUTES="360"
CRON_RUNNING_LOCK_MINUTES="30"

# Token encryption
TOKEN_ENCRYPTION_KEY=""

# File storage
# Database storage is durable for the private MVP. Move large audio to private object storage as usage grows.
FILE_STORAGE_DRIVER="database"
MAX_UPLOAD_MB="4"
MAX_AUDIO_UPLOAD_MB="4"
BLOB_READ_WRITE_TOKEN=""
MAX_DIRECT_AUDIO_UPLOAD_MB="25"
